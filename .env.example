# Copy to .env for local runs outside Docker. Every variable read by src/infrastructure/config/env.ts is listed here;
# values shown are the defaults, except where noted. Under docker compose the app service sets what it needs itself.

# --- Service -----------------------------------------------------------------------------------------------------
APP_PORT=3100
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Leave unset or "production". FAULT_INJECTION is refused unless this is "test" (the test suites set it themselves).
# NODE_ENV=production

# --- Database (required; no default) -------------------------------------------------------------------------------
DATABASE_URL=postgres://wagering:wagering@localhost:5440/wagering
DB_POOL_MAX=20
# A wallet lock held longer than this fails the request with 503 instead of queueing forever.
LOCK_TIMEOUT_MS=2000

# --- SQS (LocalStack locally; leave SQS_ENDPOINT out on real AWS) -----------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wallet-events.fifo
# Long poll, 0..20 seconds.
SQS_POLL_WAIT_SECONDS=20
# Must match the queue's redrive policy (infra/localstack/init-queues.sh).
SQS_MAX_RECEIVE_COUNT=5
# On SIGTERM, how long the consumer waits for the message in progress before giving it back.
SQS_SHUTDOWN_GRACE_MS=20000

# --- Roles: every instance can run all four; turn off what an instance should not do ----------------------------------------
RUN_HTTP=true
RUN_SQS_CONSUMER=true
RUN_OUTBOX_PUBLISHER=true
RUN_PENDING_WORKER=true

# --- Outbox publisher -------------------------------------------------------------------------------------------------
OUTBOX_POLL_INTERVAL_MS=500
# 1..100
OUTBOX_BATCH_SIZE=25
# How long a claimed batch is hidden from other publishers; a crashed publisher's rows return after this.
OUTBOX_LEASE_MS=30000
# outbox_messages_high_attempts counts unpublished events with at least this many attempts.
OUTBOX_HIGH_ATTEMPTS_THRESHOLD=10

# --- Reversals that arrive before their reference ---------------------------------------------------------------------------
PENDING_REF_MAX_ATTEMPTS=10
PENDING_REF_BASE_DELAY_MS=1000
PENDING_REF_FACTOR=2
PENDING_REF_MAX_DELAY_MS=300000
PENDING_WORKER_INTERVAL_MS=1000
# 1..100
PENDING_WORKER_BATCH_SIZE=20

# --- Tests only: crash right after the commit, before the acknowledgement. Requires NODE_ENV=test. Keep commented out. ----------------
# FAULT_INJECTION=crash-after-commit-before-ack
