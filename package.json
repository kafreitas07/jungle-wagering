{
  "name": "jungle-wagering",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "demo": "bun run scripts/demo.ts",
    "migrate": "bun run src/infrastructure/persistence/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration --timeout 30000",
    "test:concurrency": "bun test test/concurrency --timeout 120000",
    "test": "bun run test:unit && bun run test:integration && bun run test:concurrency"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1161.0",
    "@mikro-orm/core": "^7.2.6",
    "@mikro-orm/migrations": "^7.2.6",
    "@mikro-orm/postgresql": "^7.2.6",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
